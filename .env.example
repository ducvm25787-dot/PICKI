# Picki environment — never commit real secrets.

# PostgreSQL (local: docker compose -f infra/docker-compose.yml up -d)
DATABASE_URL=postgresql://picki:picki@localhost:5432/picki

# Picki-controlled Supabase (hosted Postgres + Storage — not business identity)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API (S2+)
API_PORT=3000
NODE_ENV=development

# Session signing (min 16 chars)
SESSION_SECRET=change-me-in-production-32chars

# Dev only: return OTP in API response (never in production)
AUTH_OTP_DEV_EXPOSE=true
